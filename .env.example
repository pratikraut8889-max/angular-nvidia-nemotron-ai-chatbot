# MongoDB database for user accounts, conversations, document metadata and chunks.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/chatbotAPP?retryWrites=true&w=majority
MONGODB_DB_NAME=chatbotAPP

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Use at least 32 random characters. Changing it invalidates existing login tokens.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters

# Required for Nemotron chat and NVIDIA document embeddings.
NVIDIA_API_KEY=replace_with_your_nvidia_api_key

# Optional: needed only when the AI service performs web searches.
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Optional embedding model override.
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Optional MongoDB Atlas Vector Search. If false/unset, bounded cosine search is used.
MONGODB_VECTOR_SEARCH_ENABLED=false
MONGODB_VECTOR_INDEX_NAME=document_vector_index

# Legacy password migration only. Set this to the original Cryptr secret if needed.
# Leave blank to use the historical default only if that was your old application secret.
# Existing encrypted-password accounts are upgraded after a successful login.
CRYPTR_LEGACY_SECRET=

PORT=4000